# Local development defaults for docker-compose.yml
# Copy this file to `.env` (which is gitignored) before running `docker compose up`.
# Production values are injected via Infisical → K8s Secret, NOT this file.

# --- PostgreSQL ---
POSTGRES_DB=configgen
POSTGRES_USER=configgen
POSTGRES_PASSWORD=configgen

# --- Backend ---
JWT_SECRET=dev-secret-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- OIDC (Dex local) ---
OIDC_CLIENT_ID=config-generation
OIDC_CLIENT_SECRET=config-generation-secret
OIDC_SUPERUSER_EMAILS=alice@example.com
